<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".map.CustomeMapActivity">

    <!-- Google Maps tetap memenuhi layar -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="end">


    </RelativeLayout>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom">

        <LinearLayout
            android:id="@+id/linearCafe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="vertical">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fbAubergine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:src="@drawable/ic_aubergine"
                app:backgroundTint="#fff" />


            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fbRetro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/fbAubergine"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_retro" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fbTipeSatelite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/fbRetro"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_earth" />

        </LinearLayout>

        <!-- Panel informasi berada di bawah peta -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvCafe"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_below="@id/linearCafe"
            android:layout_margin="10dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp">

            <!-- ScrollView untuk menggulir isi panel -->
            <ScrollView
                android:id="@+id/scrollDetail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="false"
                android:scrollbars="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tvNamaTempat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Nama Tempat"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4.7" />

                        <RatingBar
                            android:id="@+id/rbMap"
                            style="@style/Widget.AppCompat.RatingBar.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:progressTint="#FFEB3B"
                            android:rating="4.7" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAlamat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Alamat tempat" />

                    <ImageView
                        android:id="@+id/ivCafe"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_marginTop="10dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_cafe_map1" />

                    <Button
                        android:id="@+id/btnDetailCafe"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Detail"
                        android:textSize="20sp" />

                </LinearLayout>
            </ScrollView>

        </androidx.cardview.widget.CardView>
    </RelativeLayout>

</FrameLayout>
